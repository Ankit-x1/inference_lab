{
  "seed": 42,
  "dataset": "CIFAR-10",
  "num_classes": 10,
  "image_size": [3, 32, 32],
  "input_shape": [1, 3, 32, 32],
  "splits": {
    "train": 45000,
    "val": 5000,
    "test": 10000
  },
  "train": {
    "batch_size": 128,
    "epochs": 20,
    "lr": 0.001,
    "weight_decay": 0.01,
    "optimizer": "AdamW",
    "loss": "cross_entropy",
    "augmentation": ["random_crop_4_pad", "horizontal_flip"]
  },
  "export": {
    "opset": 13,
    "dynamic_batch": true
  },
  "quantization": {
    "method": "post_training_static",
    "calibration_method": "MinMax",
    "calibration_samples": 512,
    "calibration_source": "train_split",
    "quant_format": "QOperator",
    "weight_type": "QUInt8",
    "activation_type": "QUInt8",
    "providers": ["CPUExecutionProvider"]
  },
  "benchmark": {
    "batch_size": 1,
    "warmup": 10,
    "repetitions": 100,
    "test_samples": 1000,
    "thread_counts": [1, 4],
    "primary_metric": "median_latency_ms"
  },
  "acceptance": {
    "max_accuracy_drop_percentage_points": 1.0,
    "min_median_latency_reduction_percent": 10.0
  },
  "onnxruntime_version_note": "Install the CPU package only (onnxruntime), not onnxruntime-gpu. Verify Linux ARM64 support on the target Pi OS and Python version before pinning final versions in uv.lock."
}
